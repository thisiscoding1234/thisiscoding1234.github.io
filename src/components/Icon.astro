---

<svg 
  width={iconSize} 
  height={iconSize} 
  viewBox="0 0 24 24" 
  fill="currentColor"
  class={`icon icon-${name}`}
  aria-hidden="true"
>
  <Fragment set:html={icons[name] || icons['hexagon-image']} />
</svg>
